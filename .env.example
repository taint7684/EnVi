# ===== Supabase (bắt buộc) =====
# Lấy ở Supabase: Project Settings → API → URL + anon key (công khai, an toàn để ở client)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===== AI =====
# Google Gemini (free tier) — nhà cung cấp AI chính cho Speaking Coach & Assistant
# Lấy ở Google AI Studio. CHỈ dùng ở server, KHÔNG có tiền tố NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Groq (free tier) — fallback cho text + Whisper STT (whisper-large-v3-turbo)
# Lấy ở Groq Console. CHỈ dùng ở server.
GROQ_API_KEY=your-groq-api-key

# Ollama (tùy chọn, chạy local) — provider dự phòng
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# ===== Supabase service role =====
# CHỈ dùng cho script import (Node), KHÔNG BAO GIỜ để ở client, KHÔNG commit.
# Lấy ở Supabase: Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Cấu hình AI Router (tùy chọn) =====
# Chuỗi provider ưu tiên, phân cách bằng dấu phẩy: groq,gemini,ollama
AI_PROVIDER_CHAIN=groq,gemini,ollama
# Model theo provider (để trống để dùng mặc định của router)
GROQ_MODEL=
GEMINI_MODEL=
# Ngân sách AI theo ngày, theo task (JSON). Ví dụ: {"coach_feedback":150,"mission_turn":300}
AI_DAILY_LIMITS=
# Buộc thất bại mọi lệnh gọi AI (chỉ dev/test) để kiểm tra Offline Fallback
AI_FORCE_FAIL=

# ===== Cron / bảo mật =====
# Chỉ cho route /api/cron/* (vào Vercel Cron → Settings → Cron Jobs)
CRON_SECRET=your-cron-secret

# ===== Ghi chú =====
# Edge TTS (TTS) miễn phí, KHÔNG cần API key.
# KHÔNG bao giờ commit file .env hay .env.local lên Git.
# Các biến NEXT_PUBLIC_* sẽ lộ ở client — chỉ để giá trị công khai (URL, anon key).
# Các key AI (GEMINI_API_KEY, GROQ_API_KEY) CHỈ dùng ở server, không có tiền tố NEXT_PUBLIC_.
# Từ nay mọi tài liệu chỉ ghi TÊN biến env, KHÔNG BAO GIỜ ghi giá trị thật.
