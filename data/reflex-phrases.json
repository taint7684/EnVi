[
  {"id":"sp-01","day":1,"vi_text":"Bạn có khỏe không?","en_text":"How are you doing?","situation_en":"Greeting a colleague in the morning","keywords":["how","doing"],"level":"A2","topic":"greetings"},
  {"id":"sp-02","day":1,"vi_text":"Tôi ổn, cảm ơn. Còn bạn thì sao?","en_text":"I'm good, thanks. What about you?","situation_en":"Responding to a greeting","keywords":["good","thanks","about","you"],"level":"A2","topic":"greetings"},
  {"id":"sp-03","day":1,"vi_text":"Bạn có thể giúp tôi được không?","en_text":"Could you help me?","situation_en":"Asking a colleague for help","keywords":["could","help","me"],"level":"A2","topic":"requests"},
  {"id":"sp-04","day":1,"vi_text":"Tôi đang bận, đợi chút nhé.","en_text":"I'm busy right now, hold on a second.","situation_en":"When a colleague asks while you're busy","keywords":["busy","hold","second"],"level":"A2","topic":"requests"},
  {"id":"sp-05","day":1,"vi_text":"Bạn có hiểu không?","en_text":"Do you understand?","situation_en":"Checking if someone understood","keywords":["understand"],"level":"A2","topic":"clarification"},
  {"id":"sp-06","day":1,"vi_text":"Tôi hiểu rồi, cảm ơn bạn.","en_text":"I understand now, thank you.","situation_en":"When you understand something","keywords":["understand","now","thank"],"level":"A2","topic":"clarification"},
  {"id":"sp-07","day":1,"vi_text":"Bạn nói lại được không?","en_text":"Could you say that again?","situation_en":"Asking someone to repeat","keywords":["could","say","again"],"level":"A2","topic":"clarification"},
  {"id":"sp-08","day":1,"vi_text":"Chậm một chút được không?","en_text":"Could you slow down a bit?","situation_en":"When someone speaks too fast","keywords":["could","slow","down","bit"],"level":"A2","topic":"clarification"},
  {"id":"sp-09","day":1,"vi_text":"Hẹn gặp lại sau nhé.","en_text":"See you later.","situation_en":"Saying goodbye to a colleague","keywords":["see","later"],"level":"A2","topic":"goodbyes"},
  {"id":"sp-10","day":1,"vi_text":"Chúc một ngày tốt lành!","en_text":"Have a nice day!","situation_en":"Ending a conversation politely","keywords":["nice","day"],"level":"A2","topic":"goodbyes"},
  {"id":"sp-11","day":2,"vi_text":"Bạn đang làm gì?","en_text":"What are you working on?","situation_en":"Asking a colleague about their current task","keywords":["working"],"level":"A2","topic":"work"},
  {"id":"sp-12","day":2,"vi_text":"Tôi đang sửa lỗi trong code.","en_text":"I'm fixing a bug in the code.","situation_en":"Explaining your current task","keywords":["fixing","bug","code"],"level":"A2","topic":"work"},
  {"id":"sp-13","day":2,"vi_text":"Bạn cần tôi giúp gì không?","en_text":"Do you need me to help with anything?","situation_en":"Offering help to a colleague","keywords":["need","help","anything"],"level":"A2","topic":"work"},
  {"id":"sp-14","day":2,"vi_text":"Tôi sẽ xong trong 30 phút nữa.","en_text":"I'll be done in 30 minutes.","situation_en":"Telling someone when you'll finish","keywords":["done","minutes"],"level":"A2","topic":"work"},
  {"id":"sp-15","day":2,"vi_text":"Bạn có thể gửi file đó cho tôi không?","en_text":"Could you send me that file?","situation_en":"Asking for a file","keywords":["could","send","file"],"level":"A2","topic":"work"},
  {"id":"sp-16","day":2,"vi_text":"Tôi đã gửi email rồi.","en_text":"I've already sent the email.","situation_en":"Confirming you sent an email","keywords":["sent","email"],"level":"B1","topic":"work"},
  {"id":"sp-17","day":2,"vi_text":"Bạn có rảnh không?","en_text":"Are you free right now?","situation_en":"Checking if a colleague is available","keywords":["free","right","now"],"level":"A2","topic":"work"},
  {"id":"sp-18","day":2,"vi_text":"Tôi đang họp, 15 phút nữa nhé.","en_text":"I'm in a meeting, give me 15 minutes.","situation_en":"When you're in a meeting","keywords":["meeting","minutes"],"level":"A2","topic":"work"},
  {"id":"sp-19","day":2,"vi_text":"Cảm ơn bạn đã hỗ trợ.","en_text":"Thanks for your support.","situation_en":"Thanking a colleague for help","keywords":["thanks","support"],"level":"A2","topic":"work"},
  {"id":"sp-20","day":2,"vi_text":"Không có gì, anytime nhé.","en_text":"No problem, anytime.","situation_en":"Responding to thanks","keywords":["problem","anytime"],"level":"A2","topic":"work"},
  {"id":"sp-21","day":3,"vi_text":"Bạn có muốn đi ăn trưa không?","en_text":"Do you want to grab lunch?","situation_en":"Inviting a colleague to lunch","keywords":["want","grab","lunch"],"level":"A2","topic":"food"},
  {"id":"sp-22","day":3,"vi_text":"Tôi đói quá, đi ăn thôi.","en_text":"I'm so hungry, let's go eat.","situation_en":"When you're hungry","keywords":["hungry","eat"],"level":"A2","topic":"food"},
  {"id":"sp-23","day":3,"vi_text":"Bạn muốn uống gì?","en_text":"What would you like to drink?","situation_en":"Offering a drink","keywords":["like","drink"],"level":"A2","topic":"food"},
  {"id":"sp-24","day":3,"vi_text":"Tôi muốn một ly cà phê.","en_text":"I'd like a cup of coffee.","situation_en":"Ordering coffee","keywords":["like","cup","coffee"],"level":"A2","topic":"food"},
  {"id":"sp-25","day":3,"vi_text":"Hóa đơn ở đâu?","en_text":"Where is the bill?","situation_en":"Asking for the bill at a restaurant","keywords":["bill"],"level":"A2","topic":"food"},
  {"id":"sp-26","day":3,"vi_text":"Tôi trả tiền được không?","en_text":"Can I pay by card?","situation_en":"Asking about payment method","keywords":["pay","card"],"level":"A2","topic":"food"},
  {"id":"sp-27","day":3,"vi_text":"Món này rất ngon.","en_text":"This is really delicious.","situation_en":"Complimenting the food","keywords":["delicious"],"level":"A2","topic":"food"},
  {"id":"sp-28","day":3,"vi_text":"Bạn thích ăn gì?","en_text":"What do you like to eat?","situation_en":"Asking about food preferences","keywords":["like","eat"],"level":"A2","topic":"food"},
  {"id":"sp-29","day":3,"vi_text":"Tôi không ăn được cay.","en_text":"I can't eat spicy food.","situation_en":"Explaining food restriction","keywords":["eat","spicy"],"level":"A2","topic":"food"},
  {"id":"sp-30","day":3,"vi_text":"Ngon quá, cảm ơn bạn!","en_text":"It's delicious, thank you!","situation_en":"Thanking after a meal","keywords":["delicious","thank"],"level":"A2","topic":"food"},
  {"id":"sp-31","day":4,"vi_text":"Bạn có biết đường đến ngân hàng không?","en_text":"Do you know the way to the bank?","situation_en":"Asking for directions","keywords":["know","way","bank"],"level":"A2","topic":"directions"},
  {"id":"sp-32","day":4,"vi_text":"Đi thẳng rồi rẽ trái.","en_text":"Go straight then turn left.","situation_en":"Giving directions","keywords":["straight","turn","left"],"level":"A2","topic":"directions"},
  {"id":"sp-33","day":4,"vi_text":"Nó ở gần đây.","en_text":"It's nearby.","situation_en":"Saying a place is close","keywords":["nearby"],"level":"A2","topic":"directions"},
  {"id":"sp-34","day":4,"vi_text":"Tôi bị lạc rồi.","en_text":"I'm lost.","situation_en":"When you don't know where you are","keywords":["lost"],"level":"A2","topic":"directions"},
  {"id":"sp-35","day":4,"vi_text":"Bạn có thể chỉ đường cho tôi không?","en_text":"Could you show me the way?","situation_en":"Asking someone to show directions","keywords":["could","show","way"],"level":"A2","topic":"directions"},
  {"id":"sp-36","day":4,"vi_text":"Đi bộ mất bao lâu?","en_text":"How long does it take to walk?","situation_en":"Asking about walking time","keywords":["long","take","walk"],"level":"A2","topic":"directions"},
  {"id":"sp-37","day":4,"vi_text":"Đi xe buýt số 5.","en_text":"Take bus number 5.","situation_en":"Telling someone which bus to take","keywords":["take","bus","number"],"level":"A2","topic":"directions"},
  {"id":"sp-38","day":4,"vi_text":"Rất tiếc, tôi không biết.","en_text":"Sorry, I don't know.","situation_en":"When you don't know the answer","keywords":["sorry","know"],"level":"A2","topic":"directions"},
  {"id":"sp-39","day":4,"vi_text":"Cảm ơn bạn đã giúp!","en_text":"Thanks for your help!","situation_en":"Thanking after getting directions","keywords":["thanks","help"],"level":"A2","topic":"directions"},
  {"id":"sp-40","day":4,"vi_text":"Không có gì, chúc may mắn!","en_text":"You're welcome, good luck!","situation_en":"Responding to thanks + wishing luck","keywords":["welcome","good","luck"],"level":"A2","topic":"directions"},
  {"id":"sp-41","day":5,"vi_text":"Bạn đã bao giờ đi du lịch nước ngoài chưa?","en_text":"Have you ever traveled abroad?","situation_en":"Asking about travel experience","keywords":["ever","traveled","abroad"],"level":"B1","topic":"travel"},
  {"id":"sp-42","day":5,"vi_text":"Tôi đã đến Nhật Bản năm ngoái.","en_text":"I went to Japan last year.","situation_en":"Talking about past travel","keywords":["went","Japan","last","year"],"level":"A2","topic":"travel"},
  {"id":"sp-43","day":5,"vi_text":"Bạn muốn đi đâu?","en_text":"Where do you want to go?","situation_en":"Asking about travel destination","keywords":["want","go"],"level":"A2","topic":"travel"},
  {"id":"sp-44","day":5,"vi_text":"Tôi muốn đặt phòng khách sạn.","en_text":"I'd like to book a hotel room.","situation_en":"Booking a hotel","keywords":["like","book","hotel","room"],"level":"A2","topic":"travel"},
  {"id":"sp-45","day":5,"vi_text":"Vé máy bay bao nhiêu tiền?","en_text":"How much is a plane ticket?","situation_en":"Asking about flight price","keywords":["much","plane","ticket"],"level":"A2","topic":"travel"},
  {"id":"sp-46","day":5,"vi_text":"Tôi cần hộ chiếu.","en_text":"I need my passport.","situation_en":"When traveling internationally","keywords":["need","passport"],"level":"A2","topic":"travel"},
  {"id":"sp-47","day":5,"vi_text":"Chuyến bay bị hoãn.","en_text":"The flight is delayed.","situation_en":"When a flight is late","keywords":["flight","delayed"],"level":"A2","topic":"travel"},
  {"id":"sp-48","day":5,"vi_text":"Tôi đang đi công tác.","en_text":"I'm on a business trip.","situation_en":"Explaining you're traveling for work","keywords":["business","trip"],"level":"A2","topic":"travel"},
  {"id":"sp-49","day":5,"vi_text":"Bạn có biết nói tiếng Anh không?","en_text":"Do you speak English?","situation_en":"Asking if someone speaks English","keywords":["speak","English"],"level":"A2","topic":"travel"},
  {"id":"sp-50","day":5,"vi_text":"Tôi không hiểu, bạn nói chậm được không?","en_text":"I don't understand, could you speak slowly?","situation_en":"When you can't understand someone","keywords":["understand","speak","slowly"],"level":"A2","topic":"travel"}
]